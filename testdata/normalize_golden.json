  "out": "before\n```\nx = 1\n```\n\n\nafter\n"
 },
 {
  "name": "code block at start",
  "in": "```\nx\n```\n",
  "out": "\n```\nx\n```\n\n"
 },
 {
  "name": "two code blocks",
  "in": "a\n```\none\n```\nb\n```\ntwo\n```\nc\n",
