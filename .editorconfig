# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[testdata/**]
trim_trailing_whitespace = false
insert_final_newline = unset
